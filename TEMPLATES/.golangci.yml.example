# ©AngelaMos | 2026
# .golangci.yml.example
#
# Annotated golangci-lint v2 configuration for Cybersecurity-Projects.
# Copy next to go.mod, rename to `.golangci.yml`.
#
#   golangci-lint config verify   validate this file against the schema
#   golangci-lint run ./...       lint
#   golangci-lint fmt ./...       format (gofumpt + gci + golines)
#   golangci-lint run --fix ./... lint with autofixes
#
# Requires golangci-lint >= v2.14.0 (the gofumpt `extra` block below).
# Validated on v2.15.0, the version this repo's CI installs. Pin ONE exact
# version, in CI and on every developer machine, so lint results never
# change underneath you: older releases do not fail on `extra`, they
# silently ignore it, so local formatting would drift from CI.
#
# Docs:      https://golangci-lint.run/docs/configuration/file/
# Reference: https://github.com/golangci/golangci-lint/blob/main/.golangci.reference.yml

version: "2"

run:
  # Paths in reports and in exclusion rules are relative to go.mod, so a
  # config copied between projects behaves identically.
  relative-path-mode: gomod


# ── Linters ───────────────────────────────────────────────────────────────────
# `default: none` + an explicit list: a golangci-lint upgrade can never
# silently add a linter and turn CI red. A linter's `settings` block does
# NOTHING unless the linter is also in `enable`.

linters:
  default: none
  enable:
    # Correctness: the standard set
    - errcheck            # unchecked errors
    - govet               # go vet, all analyzers below
    - staticcheck         # SA/S/ST/QF; gosimple + stylecheck merged in v2
    - ineffassign         # assignments never read
    - unused              # dead code

    # Errors
    - errorlint           # %w wrapping, errors.Is/As instead of ==
    - nilerr              # returns nil after checking err != nil
    - nilnil              # `return nil, nil` hides the not-found case
    - errname             # ErrFoo sentinels, FooError types

    # Security
    - gosec               # G-series security checks
    - bodyclose           # http.Response.Body never closed
    - noctx               # HTTP/SQL/exec calls without a context
    - sqlclosecheck       # sql.Rows / Stmt never closed
    - rowserrcheck        # rows.Err() never checked
    - forcetypeassert     # x.(T) without ok panics on bad input

    # Context
    - contextcheck        # non-inherited context passed down
    - fatcontext          # context growing inside a loop

    # Design and complexity
    - exhaustive          # switch over an enum misses a case
    - gocritic            # broad bug and style diagnostics
    - gocognit            # cognitive complexity
    - funlen              # function length
    - dupl                # copy-pasted blocks
    - goconst             # repeated string literals that want a constant
    - unparam             # parameters that always receive the same value
    - unconvert           # redundant conversions
    - recvcheck           # mixed value/pointer receivers on one type
    - gochecknoinits      # init() with hidden side effects

    # Modern Go
    - modernize           # rewrites to current stdlib idioms
    - copyloopvar         # `x := x` copies redundant since Go 1.22
    - intrange            # for i := range n
    - usestdlibvars       # http.MethodGet instead of "GET"
    - perfsprint          # fmt.Sprintf where strconv is enough
    - exptostd            # x/exp packages that moved into std
    - predeclared         # shadowing len, new, error, ...
    - misspell

    # Tests
    - testifylint         # testify misuse
    - thelper             # t.Helper() in test helpers
    - tparallel           # inconsistent t.Parallel()
    - usetesting          # t.TempDir / t.Context over os.* in tests

    # Hygiene
    - nolintlint          # every //nolint names a linter and a reason

  settings:
    errcheck:
      check-type-assertions: true
      exclude-functions:
        - fmt.Fprint
        - fmt.Fprintf
        - fmt.Fprintln

    govet:
      enable-all: true
      disable:
        - fieldalignment  # struct reordering for padding: noise, not bugs
        - shadow          # flags the idiomatic `err :=` in nested scopes

    staticcheck:
      checks:
        - all
        - -ST1000         # package comment on every package
        - -ST1003         # initialisms (Id vs ID) in identifiers

    exhaustive:
      # A `default:` branch is a deliberate catch-all, not a missed case.
      default-signifies-exhaustive: true

    funlen:
      lines: 88
      statements: 50

    gocognit:
      min-complexity: 20

    gosec:
      excludes:
        - G104            # duplicate of errcheck

    nolintlint:
      require-explanation: true
      require-specific: true

  exclusions:
    # Generated files (with a "Code generated ... DO NOT EDIT." header) are
    # never linted.
    generated: strict
    paths:
      - vendor
      - testdata
    rules:
      - path: _test\.go
        linters:
          - funlen
          - dupl
          - goconst
          - gocognit
          - errcheck
          - forcetypeassert


# ── Issues ────────────────────────────────────────────────────────────────────
# 0 = unlimited. The defaults (50 per linter, 3 per identical message) hide
# real findings behind the first few.
#
# uniq-by-line: false. The default reports ONE issue per line, so a gosec
# hit on `http.Get(u)` silently swallows the noctx hit on the same call.

issues:
  max-issues-per-linter: 0
  max-same-issues: 0
  uniq-by-line: false


# ── Formatters ────────────────────────────────────────────────────────────────
# `golangci-lint fmt` runs these in a fixed order: gofumpt (stricter gofmt),
# then gci (import grouping), then golines (wraps long lines).
#
# gci sections: standard library, third party, then this module. The
# `localmodule` section reads the module path from go.mod, so there is no
# import prefix to hard-code (or to get the capitalization wrong in).

formatters:
  enable:
    - gofumpt
    - gci
    - golines
  settings:
    gofumpt:
      # group-params: `a, b int` instead of `a int, b int`.
      # clothe-returns: no naked returns in functions with named results.
      # (The deprecated `extra-rules: true` turned on both.)
      extra:
        group-params: true
        clothe-returns: true
    gci:
      sections:
        - standard
        - default
        - localmodule
    golines:
      max-len: 80
      reformat-tags: true
