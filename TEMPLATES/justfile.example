# ©AngelaMos | 2026
# justfile.example
#
# Annotated justfile template for Cybersecurity-Projects.
# Copy into your project root, rename to `justfile`, replace every
# <PLACEHOLDER>, and delete the groups your stack does not use.
#
# Docs:    https://just.systems/man/en/
# Install: uv tool install rust-just
#          cargo install just
#          apt install just            (Debian 13 / Ubuntu 24.04+)
#
# Usage:
#   just                  grouped list of every recipe
#   just <recipe> [args]  run one
#   just --dry-run <r>    print the commands, run nothing
#   just --fmt --check    verify this file is canonically formatted
#
# Recipe descriptions use the [doc('...')] attribute, not a comment line.
# `just --list` treats any comment DIRECTLY above a recipe as its doc, so a
# section banner touching a recipe leaks into the menu. [doc] is explicit
# and immune to that. Attributes are alphabetical, which is what
# `just --fmt` emits.
#
# ── Settings ──────────────────────────────────────────────────────────────────
# Bash strict mode for every recipe line: -e stop on first failure,
# -u unset variable is an error, -o pipefail a failing producer fails the pipe.
#
# Deliberately ABSENT, and never to be added:
#
#   set dotenv-load / set dotenv-filename / set export
#     These export ONE env file into the shell for EVERY recipe. Compose
#     resolves variables with precedence shell > --env-file, so the dev
#     values silently override the `--env-file .env` a prod recipe passes:
#     prod launches with dev ports and dev settings. Each compose recipe
#     below names its own env file instead, and the app process loads its
#     own config.
#
#   set windows-shell := ["powershell.exe", ...]
#     Recipes here use bash syntax (rm -rf, [ -f ], &&). PowerShell cannot
#     run them, so a Windows shell setting only produces a split-brain file
#     that half-works. Windows users run just from Git Bash or WSL.

set shell := ["bash", "-euo", "pipefail", "-c"]

# ── Variables ─────────────────────────────────────────────────────────────────
# Backticks run at parse time, once per invocation.

project := file_name(justfile_directory())
version := `git describe --tags --always --dirty 2>/dev/null || echo dev`
src_dir := "src"
test_dir := "tests"
package := "<package_name>"
frontend := "frontend"

# ── Compose Entry Points ──────────────────────────────────────────────────────
# One literal per environment, each sealed to its own env file. `--env-file X`
# makes compose read X INSTEAD of the implicit .env, so dev and prod can never
# bleed into each other.
#
# The project NAME lives in each compose file as a literal (`name: <proj>` in
# compose.yml, `name: <proj>-dev` in dev.compose.yml), never in an env var,
# so dev and prod are separate namespaces by construction.

prod := "docker compose -f compose.yml --env-file .env"
dev := "docker compose -f dev.compose.yml --env-file .env.development"
tunnel := "docker compose -f compose.yml -f cloudflared.compose.yml --env-file .env"

# The first recipe runs on a bare `just`. --unsorted keeps file order.

[doc('This menu')]
default:
    @just --list --unsorted

# =============================================================================
# Python: Format, Lint, Types
# =============================================================================
# Every tool runs through `uv run`, so the version is the one pinned in
# uv.lock, not whatever happens to be on PATH. yapf owns formatting
# (.style.yapf), ruff only lints. Never run `ruff format` alongside yapf:
# the two disagree and will rewrite each other's output forever.

[doc('Format with yapf in place')]
[group('python')]
format:
    uv run yapf --recursive --in-place --parallel {{ src_dir }} {{ test_dir }}

[doc('Fail if yapf would change anything')]
[group('python')]
format-check:
    uv run yapf --recursive --diff --parallel {{ src_dir }} {{ test_dir }}

[doc('ruff lint (extra flags pass through, e.g. just ruff --statistics)')]
[group('python')]
ruff *args:
    uv run ruff check {{ src_dir }} {{ test_dir }} {{ args }}

[doc('ruff lint with safe autofixes, then reformat')]
[group('python')]
fix:
    uv run ruff check --fix {{ src_dir }} {{ test_dir }}
    just format

[doc('mypy strict type check')]
[group('python')]
mypy *args:
    uv run mypy {{ src_dir }} {{ test_dir }} {{ args }}

[doc('Every Python static check')]
[group('python')]
lint: format-check ruff mypy

# =============================================================================
# Python: Tests
# =============================================================================

[doc('Run the suite (extra flags pass through, e.g. just test -k parser)')]
[group('test')]
test *args:
    uv run pytest {{ args }}

[doc('Run the suite with branch coverage')]
[group('test')]
test-cov:
    uv run pytest --cov={{ src_dir }}/{{ package }} --cov-branch \
        --cov-report=term-missing --cov-report=html

# =============================================================================
# Frontend  (delete for backend-only projects)
# =============================================================================
# `pnpm --dir` instead of `cd frontend &&`: no subshell state, and the
# recipe still works when invoked from a subdirectory.

[doc('Biome lint + format check')]
[group('frontend')]
biome:
    pnpm --dir {{ frontend }} exec biome check .

[doc('Biome with safe fixes applied')]
[group('frontend')]
biome-fix:
    pnpm --dir {{ frontend }} exec biome check --write .

[doc('Stylelint every SCSS file')]
[group('frontend')]
stylelint:
    pnpm --dir {{ frontend }} exec stylelint '**/*.scss'

[doc('TypeScript project-references type check')]
[group('frontend')]
tsc:
    pnpm --dir {{ frontend }} exec tsc -b

[doc('Every frontend check plus a production build')]
[group('frontend')]
ui-check: biome stylelint tsc
    pnpm --dir {{ frontend }} build

# =============================================================================
# Quality Gates
# =============================================================================

[doc('Fast pre-push gate: static checks, no tests')]
[group('ci')]
check: lint

[doc('Exactly what CI runs')]
[group('ci')]
ci: lint test ui-check

# =============================================================================
# Docker: Production  (compose.yml + .env)
# =============================================================================

[doc('Build production images (cached)')]
[group('prod')]
build *args:
    {{ prod }} build {{ args }}

[doc('Build production images from scratch')]
[group('prod')]
rebuild:
    {{ prod }} build --no-cache --pull

[doc('Start production stack detached')]
[group('prod')]
up *args:
    {{ prod }} up -d {{ args }}

[doc('Stop and remove production containers (volumes kept)')]
[group('prod')]
down *args:
    {{ prod }} down {{ args }}

[doc('Follow production logs (optionally for one service)')]
[group('prod')]
logs *service:
    {{ prod }} logs -f --tail=200 {{ service }}

[doc('Production container status')]
[group('prod')]
ps:
    {{ prod }} ps

[doc('Shell into a running production service')]
[group('prod')]
shell service='backend':
    {{ prod }} exec {{ service }} sh

# =============================================================================
# Docker: Dev  (dev.compose.yml + .env.development)
# =============================================================================
# The dev stack bind-mounts source for hot reload. Run every service here,
# never as a bare host process.

[doc('Start dev stack in the foreground (Ctrl-C stops it)')]
[group('dev')]
dev-up *args:
    {{ dev }} up --build {{ args }}

[doc('Start dev stack detached')]
[group('dev')]
dev-start *args:
    {{ dev }} up -d --build {{ args }}

[doc('Stop and remove dev containers (volumes kept)')]
[group('dev')]
dev-down *args:
    {{ dev }} down {{ args }}

[doc('Rebuild dev images from scratch')]
[group('dev')]
dev-rebuild:
    {{ dev }} build --no-cache --pull

[doc('Follow dev logs (optionally for one service)')]
[group('dev')]
dev-logs *service:
    {{ dev }} logs -f --tail=200 {{ service }}

[doc('Dev container status')]
[group('dev')]
dev-ps:
    {{ dev }} ps

[doc('Shell into a running dev service')]
[group('dev')]
dev-shell service='backend':
    {{ dev }} exec {{ service }} sh

[doc('Run the test suite inside the dev backend container')]
[group('dev')]
dev-test *args:
    {{ dev }} exec backend uv run pytest {{ args }}

# =============================================================================
# Tunnel: Public Deploy  (compose.yml + cloudflared.compose.yml + .env)
# =============================================================================
# `redeploy` is the one command for shipping: down (data volumes kept, orphans
# from renamed/removed services swept), cached build, up detached. It never
# prunes anything outside this compose project: --remove-orphans only sees
# containers carrying THIS project's label.

[doc('Rebuild and restart the public stack, keeping data')]
[group('tunnel')]
redeploy: (tunnel-down "--remove-orphans") build (tunnel-start "--remove-orphans")

[doc('Start the public stack in the foreground')]
[group('tunnel')]
tunnel-up *args:
    {{ tunnel }} up {{ args }}

[doc('Start the public stack detached')]
[group('tunnel')]
tunnel-start *args:
    {{ tunnel }} up -d {{ args }}

[doc('Stop the public stack (volumes kept)')]
[group('tunnel')]
tunnel-down *args:
    {{ tunnel }} down {{ args }}

[doc('Follow public stack logs')]
[group('tunnel')]
tunnel-logs *service:
    {{ tunnel }} logs -f --tail=200 {{ service }}

# =============================================================================
# Database  (Alembic inside the running container; delete if no database)
# =============================================================================

[doc('Apply migrations (default: head)')]
[group('db')]
migrate target='head':
    {{ dev }} exec backend uv run alembic upgrade {{ target }}

[doc('Autogenerate a migration: just migration "add users table"')]
[group('db')]
migration message:
    {{ dev }} exec backend uv run alembic revision --autogenerate -m "{{ message }}"

[doc('Roll back one migration')]
[group('db')]
rollback:
    {{ dev }} exec backend uv run alembic downgrade -1

[doc('Show applied revision and history')]
[group('db')]
db-status:
    {{ dev }} exec backend uv run alembic current --verbose
    {{ dev }} exec backend uv run alembic history --indicate-current

# =============================================================================
# Setup
# =============================================================================

[doc('First-time bootstrap: deps, env files, git hooks')]
[group('setup')]
setup: env
    uv sync
    pnpm --dir {{ frontend }} install
    uv run pre-commit install

[doc('Create missing env files from their .example templates')]
[group('setup')]
env:
    [ -f .env ] || cp .env.example .env
    [ -f .env.development ] || cp .env.example .env.development

# =============================================================================
# Utilities
# =============================================================================

[doc('Project, version and platform')]
[group('util')]
info:
    @echo "project  {{ project }}"
    @echo "version  {{ version }}"
    @echo "platform {{ os() }}/{{ arch() }}"

[doc('Remove caches and build output (keeps .venv and node_modules)')]
[group('util')]
clean:
    rm -rf .mypy_cache .pytest_cache .ruff_cache .hypothesis htmlcov \
        .coverage .coverage.* dist build {{ frontend }}/dist
    find . -type d -name __pycache__ -prune -exec rm -rf {} +

[confirm('Delete .venv, node_modules and every cache?')]
[doc('clean, plus every installed dependency')]
[group('util')]
nuke: clean
    rm -rf .venv {{ frontend }}/node_modules
