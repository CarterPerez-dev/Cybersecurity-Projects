# ©AngelaMos | 2026
# .env.example

# Production. The dev stack reads .env.development instead, so the two
# environments never share a file and neither can edit the other's
# inputs by accident.

NS_UI_PORT=33572
NS_PROXY_PORT=39441

VITE_API_URL=/api
VITE_APP_TITLE=not-sandboxed arena

# Absolute origin the site is served from, no trailing slash.
# Leave empty for local runs; social scrapers that require an absolute
# URL will not resolve the share card until this is set.
VITE_SITE_URL=

# Append-only JSONL verdict log. Empty disables it entirely, which is
# the default posture: no path, no records. The container mounts a
# writable volume at /var/lib/not-sandboxed.
NS_AUDIT_PATH=/var/lib/not-sandboxed/audit.jsonl

# Level-6 bypasses land here for `just harvest` to export. Untrusted
# input never writes itself into the corpus.
NS_BYPASS_PATH=/var/lib/not-sandboxed/bypasses.jsonl
