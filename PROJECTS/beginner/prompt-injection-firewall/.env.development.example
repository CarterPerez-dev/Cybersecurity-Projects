# .env.development.example

# Development only. `just arena-dev` passes this file explicitly, so
# nothing here can reach a production recipe.

NS_UI_DEV_PORT=61878

VITE_API_URL=/api
VITE_APP_TITLE=not-sandboxed arena (dev)
VITE_SITE_URL=

NS_AUDIT_PATH=/var/lib/not-sandboxed/audit.jsonl
NS_BYPASS_PATH=/var/lib/not-sandboxed/bypasses.jsonl
