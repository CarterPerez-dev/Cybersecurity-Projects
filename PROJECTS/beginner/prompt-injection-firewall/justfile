# justfile

set shell := ["bash", "-uc"]

default:
    @just --list

lint:
    uv run ruff check .
    uv run mypy src/ tests/ bench/

format:
    uv run yapf -r -i src/ tests/ bench/

check-format:
    uv run yapf -r -d src/ tests/ bench/

test:
    uv run pytest tests/ -v

bench:
    uv run python -m bench.runner

check: lint check-format test
